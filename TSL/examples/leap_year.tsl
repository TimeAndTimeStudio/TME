# Leap Year Check
function is_leap_year(year):
    if year % 4 == 0:
        if year % 100 == 0:
            if year % 400 == 0:
                return true
            else:
                return false
        else:
            return true
    else:
        return false

print(is_leap_year(2024))
print(is_leap_year(1900))
print(is_leap_year(2000))
