# Binary Tree Node
function create_tree_node(value):
    return { value: value, left: null, right: null }

# Insert into BST
function insert(root, value):
    if root == null:
        return create_tree_node(value)
    
    if value < root.value:
        root.left = insert(root.left, value)
    else:
        root.right = insert(root.right, value)
    
    return root

# In-order traversal
function inorder(root):
    if root != null:
        inorder(root.left)
        print(root.value)
        inorder(root.right)

root = null
root = insert(root, 5)
root = insert(root, 3)
root = insert(root, 7)
root = insert(root, 1)
root = insert(root, 4)

inorder(root)
