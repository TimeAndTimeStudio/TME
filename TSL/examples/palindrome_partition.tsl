# Dynamic Programming - Palindrome Partitioning
function string_length(s):
    len = 0
    for ch in s:
        len = len + 1
    return len

function get_char(s, i):
    j = 0
    for ch in s:
        if j == i:
            return ch
        j = j + 1
    return ""

function is_palindrome(s):
    i = 0
    j = string_length(s) - 1
    while i < j:
        if get_char(s, i) != get_char(s, j):
            return false
        i = i + 1
        j = j - 1
    return true

function min_cut(s):
    n = string_length(s)
    if n == 0:
        return 0
    
    dp = []
    i = 0
    while i < n:
        dp[i] = i
        i = i + 1
    
    i = 1
    while i < n:
        j = 0
        while j <= i:
            if is_palindrome(s) == true:
                if j == 0:
                    dp[i] = 0
                else:
                    if dp[j - 1] + 1 < dp[i]:
                        dp[i] = dp[j - 1] + 1
            j = j + 1
        i = i + 1
    
    return dp[n - 1]

s = "aab"
result = min_cut(s)
print(result)
