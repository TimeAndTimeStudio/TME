# Days in Month
function days_in_month(month, year):
    if month == 2:
        if year % 4 == 0:
            if year % 100 == 0:
                if year % 400 == 0:
                    return 29
                else:
                    return 28
            else:
                return 29
        else:
            return 28
    else:
        if month == 4 or month == 6 or month == 9 or month == 11:
            return 30
        else:
            return 31

print(days_in_month(2, 2024))
print(days_in_month(1, 2024))
