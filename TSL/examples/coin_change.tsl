# Dynamic Programming - Coin Change
function coin_change(coins, amount):
    dp = []
    i = 0
    while i <= amount:
        dp[i] = 999999
        i = i + 1
    dp[0] = 0
    
    i = 0
    while i < coins.length:
        j = coins[i]
        while j <= amount:
            if dp[j - coins[i]] + 1 < dp[j]:
                dp[j] = dp[j - coins[i]] + 1
            j = j + 1
        i = i + 1
    
    if dp[amount] > amount:
        return (0 - 1)
    return dp[amount]

coins = [1, 2, 5]
amount = 11
result = coin_change(coins, amount)
print(result)
