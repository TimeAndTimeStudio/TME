# Dynamic Programming - Trapping Rain Water
function trap(rain):
    n = rain.length
    if n == 0:
        return 0
    
    left_max = []
    right_max = []
    i = 0
    while i < n:
        left_max[i] = 0
        right_max[i] = 0
        i = i + 1
    
    i = 1
    while i < n:
        if rain[i - 1] > left_max[i - 1]:
            left_max[i] = rain[i - 1]
        else:
            left_max[i] = left_max[i - 1]
        i = i + 1
    
    i = n - 2
    while i >= 0:
        if rain[i + 1] > right_max[i + 1]:
            right_max[i] = rain[i + 1]
        else:
            right_max[i] = right_max[i + 1]
        i = i - 1
    
    water = 0
    i = 0
    while i < n:
        min_max = left_max[i]
        if right_max[i] < min_max:
            min_max = right_max[i]
        if min_max > rain[i]:
            water = water + min_max - rain[i]
        i = i + 1
    
    return water

rain = [0, 1, 0, 2, 1, 0, 1, 3, 2, 1, 2, 1]
result = trap(rain)
print(result)
