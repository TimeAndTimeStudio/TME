# Dynamic Programming - Matrix Chain Multiplication
function matrix_chain(p):
    n = p.length - 1
    dp = []
    s = []
    
    i = 0
    while i < n:
        dp[i] = []
        s[i] = []
        j = 0
        while j < n:
            dp[i][j] = 0
            s[i][j] = 0
            j = j + 1
        i = i + 1
    
    l = 2
    while l <= n:
        i = 0
        while i <= n - l:
            j = i + l - 1
            dp[i][j] = 999999
            k = i
            while k < j:
                q = dp[i][k] + dp[k + 1][j] + p[i] * p[k + 1] * p[j + 1]
                if q < dp[i][j]:
                    dp[i][j] = q
                    s[i][j] = k
                k = k + 1
            i = i + 1
        l = l + 1
    
    return dp[0][n - 1]

p = [1, 2, 3, 4]
result = matrix_chain(p)
print(result)
