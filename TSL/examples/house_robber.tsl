# Dynamic Programming - House Robber
function rob(houses):
    n = 0
    for item in houses:
        n = n + 1
    if n == 0:
        return 0
    else:
        if n == 1:
            return houses[0]
    
    prev2 = 0
    prev1 = houses[0]
    i = 1
    
    while i < n:
        current = prev1
        include = prev2 + houses[i]
        exclude = prev1
        if include > exclude:
            prev2 = prev1
            prev1 = include
        else:
            prev2 = prev1
        i = i + 1
    
    return prev1

houses = [2, 7, 9, 3, 1]
result = rob(houses)
print(result)
