# Dynamic Programming - Edit Distance
function string_length(s):
    len = 0
    for ch in s:
        len = len + 1
    return len

function get_char(s, i):
    j = 0
    for ch in s:
        if j == i:
            return ch
        j = j + 1
    return ""

function edit_distance(s1, s2):
    m = string_length(s1)
    n = string_length(s2)
    
    dp = []
    i = 0
    while i <= m:
        dp[i] = []
        j = 0
        while j <= n:
            if i == 0:
                dp[i][j] = j
            else:
                if j == 0:
                    dp[i][j] = i
                else:
                    if get_char(s1, i - 1) == get_char(s2, j - 1):
                        dp[i][j] = dp[i - 1][j - 1]
                    else:
                        dp[i][j] = (1 + min(dp[i][j - 1], dp[i - 1][j], dp[i - 1][j - 1]))
            j = j + 1
        i = i + 1
    
    return dp[m][n]

function min(a, b, c):
    m = a
    if b < m:
        m = b
    if c < m:
        m = c
    return m

result = edit_distance("kitten", "sitting")
print(result)
