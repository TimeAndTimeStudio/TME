# Dynamic Programming - Longest Increasing Subsequence
function lis(arr):
    n = 0
    for item in arr:
        n = n + 1
    
    if n == 0:
        return 0
    
    dp = []
    i = 0
    while i < n:
        dp[i] = 1
        i = i + 1
    
    i = 1
    while i < n:
        j = 0
        while j < i:
            if arr[i] > arr[j] and dp[j] + 1 > dp[i]:
                dp[i] = dp[j] + 1
            j = j + 1
        i = i + 1
    
    max_len = 0
    i = 0
    while i < n:
        if dp[i] > max_len:
            max_len = dp[i]
        i = i + 1
    
    return max_len

arr = [10, 22, 9, 33, 21, 50, 41, 60]
result = lis(arr)
print(result)
