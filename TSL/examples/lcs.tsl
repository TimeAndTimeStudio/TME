# Dynamic Programming - Longest Common Subsequence
function lcs(s1, s2):
    m = 0
    for ch in s1:
        m = m + 1
    
    n = 0
    for ch in s2:
        n = n + 1
    
    dp = []
    i = 0
    while i <= m:
        dp[i] = []
        j = 0
        while j <= n:
            dp[i][j] = 0
            j = j + 1
        i = i + 1
    
    i = 1
    while i <= m:
        j = 1
        while j <= n:
            if s1[i - 1] == s2[j - 1]:
                dp[i][j] = dp[i - 1][j - 1] + 1
            else:
                if dp[i - 1][j] > dp[i][j - 1]:
                    dp[i][j] = dp[i - 1][j]
                else:
                    dp[i][j] = dp[i][j - 1]
            j = j + 1
        i = i + 1
    
    return dp[m][n]

result = lcs("AGGTAB", "GXTXAYB")
print(result)
