# Jump Game — TME Example

player = { x: 100, y: 400, vy: 0 }
JUMP_FORCE = 300
GRAVITY = 800
GROUND = 400
W = 1920

function handleFullscreenExit():
  print("Exited fullscreen!")

setFullscreenCallback(handleFullscreenExit)

function update(dt):
  if key("space") or touch.down(0):
    player.vy = (0 - JUMP_FORCE)

  player.vy = (player.vy + (GRAVITY * dt))
  player.y = (player.y + (player.vy * dt))

  if (player.y > GROUND):
    player.y = GROUND
    player.vy = 0

function draw():
  canvasSize = getCanvasSize()
  W = canvasSize.width
  rect(0, GROUND, W, 50, "#8B4513")
  rect(player.x, player.y, 50, 50, "#0000FF")
  image("img/img1.png", player.x - 25, player.y - 60, 50, 50)

fps(60)
setGame({update: update, draw: draw})
