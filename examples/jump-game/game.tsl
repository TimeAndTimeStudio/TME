# Jump Game — TME Example

player = { x: 100, y: 400, vy: 0 }
JUMP_FORCE = 300
GRAVITY = 800
GROUND = 400

function update(dt):
  if input.keyboard.is_down("space") or touch.tap():
    player.vy = (0 - JUMP_FORCE)

  player.vy = (player.vy + (GRAVITY * dt))
  player.y = (player.y + (player.vy * dt))

  if (player.y > GROUND):
    player.y = GROUND
    player.vy = 0

function draw():
  canvasSize = getCanvasSize()
  W = canvasSize.width
  rect(0, GROUND, W, 50, "brown")
  rect(player.x, player.y, 50, 50, "blue")

fps(60)
setGame({update: update, draw: draw})
